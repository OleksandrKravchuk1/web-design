{
  "name": "devtools-showcase",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"json-server --watch api/db.json --routes api/routes.json --port 5174\"",
    "dev:vite": "concurrently \"vite\" \"json-server --watch api/db.json --routes api/routes.json --port 5174\"",
    "build": "npm run lint && npm run validate:src && vite build && npm run validate",
    "build:vite": "npm run build",
    "preview": "vite preview",
    "preview:vite": "npm run lint && vite preview",
    "lint": "eslint .",
    "validate:src": "node scripts/check-src.js",
    "validate": "html-validate \"dist/*.html\" && node scripts/check-dist.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^8.2.2",
    "ejs": "^7.0.2",
    "eslint": "^9.8.0",
    "globals": "^17.13.0",
    "html-validate": "^11.17.0",
    "json-server": "^0.17.4",
    "sass": "^1.80.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "dayjs": "^1.11.11"
  },
  "description": "Dev Tools Showcase — web course project (topic 7)"
}

<%#
  <head> без стилів. Параметри: titleKey, descriptionKey — ключі з meta.* словника.
  Стилі поки не підключаються: оформлення додається в ЛР3 (SCSS 7-1).
%>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title data-i18n="<%= titleKey %>"><%= t(titleKey) %></title>
<meta name="description" content="<%= t(descriptionKey) %>" data-i18n-attr="content:<%= descriptionKey %>">
